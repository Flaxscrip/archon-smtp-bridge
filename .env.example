# SMTP-DMail Bridge Configuration

# ─────────────────────────────────────────────────────────────
# INBOUND SMTP (receiving external emails)
# ─────────────────────────────────────────────────────────────
SMTP_PORT=2525
SMTP_DOMAIN=archon.social

# ─────────────────────────────────────────────────────────────
# ARCHON SERVICES
# ─────────────────────────────────────────────────────────────
ARCHON_SOCIAL_API=https://archon.social
GATEKEEPER_URL=https://archon.technology/api/v1

# ─────────────────────────────────────────────────────────────
# WALLET (Bridge Identity)
# ─────────────────────────────────────────────────────────────
# The bridge signs DMails with this identity
WALLET_PATH=wallet.json
WALLET_DIR=./data
ARCHON_PASSPHRASE=your-wallet-passphrase

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
DB_PATH=./data/bridge.db

# ─────────────────────────────────────────────────────────────
# OUTBOUND SMTP (sending replies to external email)
# ─────────────────────────────────────────────────────────────
SMTP_OUT_ENABLED=true
SMTP_OUT_HOST=localhost
SMTP_OUT_PORT=25
# SMTP_OUT_USER=your-smtp-username
# SMTP_OUT_PASS=your-smtp-password
# SMTP_OUT_SECURE=false
SMTP_OUT_FROM=bridge@archon.social
SMTP_OUT_NAME=Archon Bridge

# ─────────────────────────────────────────────────────────────
# REPLY POLLER (monitors for DMail replies)
# ─────────────────────────────────────────────────────────────
REPLY_POLLER_ENABLED=true
REPLY_POLL_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────
# LIMITS
# ─────────────────────────────────────────────────────────────
MAX_EMAIL_SIZE_BYTES=10485760
MAX_RETRIES=3
