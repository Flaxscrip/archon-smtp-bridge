{
  "name": "@archon-protocol/smtp-dmail-bridge",
  "version": "0.3.0",
  "description": "SMTP to DMail bridge - receive external emails as encrypted DMail messages",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "smtp-dmail-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test"
  },
  "keywords": ["archon", "smtp", "dmail", "email", "bridge", "did"],
  "author": "Archon Protocol",
  "license": "MIT",
  "dependencies": {
