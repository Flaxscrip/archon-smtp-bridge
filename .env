# SMTP Bridge Configuration

# SMTP Server
SMTP_PORT=2525
SMTP_DOMAIN=archon.social

# Archon Integration
ARCHON_SOCIAL_API=https://archon.social
GATEKEEPER_URL=https://archon.technology/api/v1

# Bridge Wallet (the DID that signs outgoing DMails)
# Use the server's Archon wallet - typically at archon/data/wallet.json
WALLET_PATH=wallet.json
WALLET_DIR=data
ARCHON_PASSPHRASE=thelema

# Alternative: Connect to shared Keymaster server
# KEYMASTER_URL=http://localhost:4226

# Rate Limiting
MAX_EMAILS_PER_SENDER_HOUR=10
MAX_EMAIL_SIZE_BYTES=10485760

# Reply Polling (DMail → SMTP outbound)
ENABLE_REPLY_POLLER=true
REPLY_POLL_INTERVAL_MS=60000

# Logging
LOG_LEVEL=info
